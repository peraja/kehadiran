DirectoryIndex index.php

# ============================================================
#  .htaccess AMAN untuk cPanel
#  Tidak memuat direktif yang sering dilarang hosting
#  (SecRuleEngine / php_value), sehingga tidak memicu Error 500.
#
#  Perlindungan terhadap ModSecurity sudah ditangani di sisi
#  aplikasi: POST memakai multipart/form-data dan data tanda
#  tangan dikirim sebagai base64 mentah tanpa prefix "data:".
# ============================================================

# ------------------------------------------------------------
#  1. KEAMANAN FILE SENSITIF
# ------------------------------------------------------------
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3|md|lock|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(\.htaccess|\.htaccess-.*|\.env|package\.json|package-lock\.json|server\.js|create_assets\.js|build_zip\.py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# File .html adalah versi lama untuk server.js (Node.js) dan tidak
# memuat perbaikan cPanel. Blokir agar tidak terpakai tanpa sengaja.
<FilesMatch "\.html$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
#  2. ROUTING
#     Tanpa "RewriteBase" dan memakai target relatif supaya
#     bekerja di root domain MAUPUN subfolder.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lewati file & folder yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- API: endpoint REST ---
    RewriteRule ^api/events/portal/?$          api.php?action=events_portal [L,QSA]
    RewriteRule ^api/events/all/?$             api.php?action=events_all [L,QSA]
    RewriteRule ^api/meeting/([a-zA-Z0-9_-]+)/?$ api.php?action=meeting_by_code&code=$1 [L,QSA]
    RewriteRule ^api/events/([0-9]+)/status/?$ api.php?action=admin_toggle_event_status&id=$1 [L,QSA]
    RewriteRule ^api/events/([0-9]+)/?$        api.php?action=admin_update_event&id=$1 [L,QSA]
    RewriteRule ^api/events/?$                 api.php?action=events [L,QSA]
    RewriteRule ^api/attendance/?$             api.php?action=attendance [L,QSA]
    RewriteRule ^api/skm-setting/?$            api.php?action=skm_setting [L,QSA]
    RewriteRule ^api/login/?$                  api.php?action=login [L,QSA]
    RewriteRule ^api/logout/?$                 api.php?action=logout [L,QSA]
    RewriteRule ^api/agencies/?$               api.php?action=agencies [L,QSA]
    RewriteRule ^api/diag/?$                   api.php?action=diag [L,QSA]

    # --- API: admin ---
    RewriteRule ^api/admin/check-auth/?$       api.php?action=check_auth [L,QSA]
    RewriteRule ^api/admin/dashboard/?$        api.php?action=admin_dashboard [L,QSA]
    RewriteRule ^api/admin/events/?$           api.php?action=admin_events [L,QSA]
    RewriteRule ^api/admin/attendances/?$      api.php?action=admin_attendances [L,QSA]
    RewriteRule ^api/admin/settings/skm/?$     api.php?action=admin_update_skm [L,QSA]
    RewriteRule ^api/admin/change-password/?$  api.php?action=admin_change_password [L,QSA]
    RewriteRule ^api/admin/users/([0-9]+)/?$   api.php?action=admin_delete_user&id=$1 [L,QSA]
    RewriteRule ^api/admin/users/?$            api.php?action=admin_users [L,QSA]
    RewriteRule ^api/admin/create-user/?$      api.php?action=admin_create_user [L,QSA]

    # --- Halaman ---
    RewriteRule ^meeting/([a-zA-Z0-9_-]+)/?$   meeting.php?code=$1 [L,QSA]
    RewriteRule ^attamaki/?$                   login.php [L,QSA]
    RewriteRule ^panel-admin/?$                admin.php [L,QSA]
</IfModule>
