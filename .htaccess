<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Blokir akses langsung ke file tersembunyi (seperti .env, .git)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # 2. Blokir akses langsung ke direktori sensitif jika diletakkan di root
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # 3. Layani aset statis jika berkas berada di folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 4. Arahkan seluruh rute aplikasi langsung ke public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
