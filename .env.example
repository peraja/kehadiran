APP_NAME=eRapat
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://rapat.sinjaikab.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database Configuration (MySQL / MariaDB untuk cPanel)
# Di cPanel: biasanya nama DB & User diawali dengan cpanel_username (misal: usercpanel_erapat)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_cpanel
DB_USERNAME=nama_user_cpanel
DB_PASSWORD=password_database_cpanel

# Session, Cache, Queue & Storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail Configuration (Gunakan SMTP cPanel / Mail server resmi)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.sinjaikab.go.id
MAIL_PORT=465
MAIL_USERNAME=erapat@sinjaikab.go.id
MAIL_PASSWORD=password_email_cpanel
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="erapat@sinjaikab.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway SIMPEG Kepegawaian Pemkab Sinjai
SIMPEG_API_URL=http://apps.sinjaikab.go.id/api/pegawai
SIMPEG_API_TIMEOUT=10

# API PPPK Paruh Waktu Pemkab Sinjai
PPPK_PW_API_URL=https://tte.sinjaikab.go.id/api/v1/pppk-pw
PPPK_PW_API_TOKEN=
PPPK_PW_API_TIMEOUT=5

# TTE BSrE (Esign Client Service BSSN v2)
BSRE_ESIGN_URL=http://ip-atau-domain-bsre:8080/api/v2
BSRE_AUTH_USERNAME=
BSRE_AUTH_PASSWORD=
BSRE_SIGN_LOCATION="Kabupaten Sinjai"

# Google Gemini AI (Asisten Notulen & Ringkasan Rapat)
GEMINI_API_KEY=

# Frontend Assets
VITE_APP_NAME="${APP_NAME}"
